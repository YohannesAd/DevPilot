# Copy to backend/.env and replace the placeholder locally. Never commit .env.
# URL-encode special characters in the username/password (for example @ as %40).
DATABASE_URL=postgresql+psycopg://devpilot_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/devpilot

# Browser URLs must both use localhost in local development.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
# Deployment: APP_ENV=production and explicit HTTPS origins (no trailing slash).
# Production automatically sets Secure on the authentication cookie.

# Shared PostgreSQL authentication limits. Requires migration 0007_auth_rate_limits.
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_IP_WINDOW_SECONDS=600
AUTH_LOGIN_EMAIL_LIMIT=10
AUTH_LOGIN_EMAIL_WINDOW_SECONDS=900
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_IP_WINDOW_SECONDS=3600
# Production: supply a shared random secret from your secret store (at least 32 bytes).
# Blank uses a stable DEVELOPMENT-ONLY key; production rejects a blank key.
AUTH_RATE_KEY_SECRET=
# Comma-separated exact proxy IPs/CIDRs, empty means trust no forwarded headers.
# Start Uvicorn with --no-proxy-headers; the app resolves the untouched peer itself.
AUTH_TRUSTED_PROXY_CIDRS=
